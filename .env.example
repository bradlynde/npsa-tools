# Auth Service - set in Railway
JWT_SECRET=your-secret-here
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated origins allowed to call this service from a browser
CORS_ORIGINS=https://npsa-tools.vercel.app,http://localhost:3000

# Sending login codes. Without RESEND_API_KEY nothing is sent and the code is
# not logged; set AUTH_DEV_LOG_CODES=1 locally to log it instead. Never in production.
RESEND_API_KEY=re_xxxxxxxx
# AUTH_DEV_LOG_CODES=1
AUTH_EMAIL_FROM=NPSA Tools <login@nonprofitsecurityadvisors.com>

# How long a sign-in lasts without use (hours). The toolbox renews the token
# while someone uses it, so this is an inactivity window. Default 336 (14 days).
JWT_EXPIRATION_HOURS=336

# Longest a sign-in can be kept alive by renewal before a fresh code is needed (days).
AUTH_MAX_SESSION_DAYS=30

# Wrong codes allowed per address in a rolling 24 hours before sign-in is locked.
AUTH_MAX_FAILED_VERIFIES=15
